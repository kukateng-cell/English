// SQLite schema — 仅用于本地预览（不进生产、不动 prisma/schema.prisma）
// 差异：String[] / Json 在 SQLite 下改用 String 存储（JSON 字符串），由业务层读写时转换。

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // 角色变更令牌版本号：管理员修改用户角色时 +1，
  // jwt 回调据此在下次请求时刷新缓存的角色（实时生效机制）。
  tokenVersion Int      @default(0)
  // 首次登入強制改密碼：seed 的學生帳號預設 true，重設密碼後設 false。
  mustChangePassword Boolean @default(true)
  createdAt    DateTime @default(now())
  reviews      Review[]
}

model Word {
  id         String   @id @default(cuid())
  term       String   @unique
  phonetic   String?
  pos        String?
  definition String
  level      String // A1 / A2 / B1（SQLite 无 enum）
  category   String?
  examples   String? // JSON 字符串
  synonyms   String? // JSON 字符串数组
  antonyms   String? // JSON 字符串数组
  imageUrl   String?
  reviews    Review[]

  @@index([level])
  @@index([category])
}

model Review {
  id             String   @id @default(cuid())
  userId         String
  wordId         String
  easeFactor     Float    @default(2.5)
  interval       Int      @default(0)
  repetitions    Int      @default(0)
  nextReviewDate DateTime
  lastReviewedAt DateTime?
  totalReviews   Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewDate])
}
