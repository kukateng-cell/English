model StudentYearTransition {
  id                       String              @id @default(cuid())
  studentId                String
  sourceEnrollmentId       String              @unique
  sourceAcademicYearId     String
  targetAcademicYearId     String
  disposition              RolloverDisposition
  targetEnrollmentId       String?
