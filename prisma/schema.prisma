// Prisma schema — PostgreSQL（本地开发与生产部署统一连 Postgres / Supabase）。
// 项目已统一切到 Postgres，旧的 SQLite 预览版已移除。

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── 用户（账号+密码登录） ──
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(STUDENT)
  // 角色变更令牌版本号：管理员修改用户角色时 +1，
  // jwt 回调据此在下次请求时刷新缓存的角色（实时生效机制）。
  tokenVersion Int      @default(0)
  // 首次登入強制改密碼：seed 的學生帳號預設 true，重設密碼後設 false。
  mustChangePassword Boolean @default(true)
  createdAt    DateTime @default(now())
  reviews      Review[]
}

// ── 单词（来自 word list.md + ECDICT） ──
model Word {
  id         String   @id @default(cuid())
  term       String   @unique
  phonetic   String?
  pos        String?
  definition String
  level      Level            // A1 / A2 / B1 / B2
  category   String?          // 主题（Family / Colors ...）
  examples   Json?            // 例句数组 [{"en":"...","zh":"..."}]
  synonyms   String[]         // 近义词
  antonyms   String[]         // 反义词
  imageUrl   String?          // 助记图
  reviews    Review[]

  @@index([level])
  @@index([category])
}

// ── 学习记录（每用户每词一份 SM-2 状态） ──
model Review {
  id             String   @id @default(cuid())
  userId         String
  wordId         String
  easeFactor     Float    @default(2.5)
  interval       Int      @default(0)
  repetitions    Int      @default(0)
  nextReviewDate DateTime
  lastReviewedAt DateTime?
  totalReviews   Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewDate])
}

enum Level {
  A1
  A2
  B1
  B2
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}
