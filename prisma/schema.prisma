  targetEnrollment         StudentEnrollment?  @relation("TransitionTargetEnrollment", fields: [targetEnrollmentId], references: [id], onDelete: NoAction)
  sourceAcademicYear       AcademicYear        @relation("TransitionSourceYear", fields: [sourceAcademicYearId], references: [id], onDelete: NoAction)
  targetAcademicYear       AcademicYear        @relation("TransitionTargetYear", fields: [targetAcademicYearId], references: [id], onDelete: NoAction)
  actor                    User?               @relation("TransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([studentId, sourceAcademicYearId, targetAcademicYearId])
  @@unique([targetEnrollmentId])
  @@index([sourceAcademicYearId, disposition])
  @@index([targetAcademicYearId, disposition])
  @@index([actorUserId])
}

model AdminMutationBatch {
  id                   String                       @id @default(cuid())
  actorUserId          String?
  actorPseudonym       String?
  hmacKeyVersion       String?
  operationKind        AdminMutationKind
  operationId          String
  status               AdminMutationStatus          @default(PREVIEWED)
  filterHash           String?
  canonicalDigest      String?
  rosterRevision       Int?
  calendarRevision     Int?
  sourceAcademicYearId String?
  targetAcademicYearId String?
  sourceYearRevision   Int?
  targetYearRevision   Int?
  payload              Json?
  errorReport          Json?
  counts               Json?
  expiresAt            DateTime
  committedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  actor                User?                        @relation("AdminMutationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceAcademicYear   AcademicYear?                @relation("AdminMutationSourceYear", fields: [sourceAcademicYearId], references: [id], onDelete: SetNull)
  targetAcademicYear   AcademicYear?                @relation("AdminMutationTargetYear", fields: [targetAcademicYearId], references: [id], onDelete: SetNull)
  userLinks            AdminMutationBatchUserLink[]

  @@unique([actorUserId, operationKind, operationId])
  @@index([actorUserId, createdAt])
  @@index([status, expiresAt])
}

model AdminOperationReceipt {
  id                 String            @id @default(cuid())
  actorUserId        String?
  actorPseudonym     String?
  hmacKeyVersion     String?
  operationKind      AdminMutationKind
  operationId        String
  requestFingerprint String
  outcomeStatus      String
  summary            Json?
  createdAt          DateTime          @default(now())
  actor              User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([actorUserId, operationKind, operationId])
  @@index([actorUserId, createdAt])
}

model RosterImportBatchUserLink {
  batchId   String
  userId    String
  linkRole  BatchUserLinkRole
  createdAt DateTime          @default(now())
  batch     RosterImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([batchId, userId, linkRole])
  @@index([userId, batchId])
}

model AdminMutationBatchUserLink {
  batchId   String
  userId    String
  linkRole  BatchUserLinkRole
  createdAt DateTime           @default(now())
  batch     AdminMutationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([batchId, userId, linkRole])
  @@index([userId, batchId])
}

model RecentAuthGrant {
  id                 String   @id
  userId             String
  tokenVersion       Int
  credentialRevision Int
  reauthenticatedAt  DateTime
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
