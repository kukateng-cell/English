// Prisma schema — PostgreSQL（本地开发与生产部署统一连 Postgres / Supabase）。
// 项目已统一切到 Postgres，旧的 SQLite 预览版已移除。

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── 用户（账号+密码登录） ──
model User {
  id                                String                              @id @default(cuid())
  // Keep the physical column named email during the expand/rollback window:
  // legacy binaries still use it as the login account. New code uses the
  // truthful accountName contract and stores real contact mail separately.
  accountName                       String                              @unique @map("email")
  // Nullable companion used by the canonical writer during the expand window.
  // The physical login column remains mapped to email until a separately
  // approved contract migration retires legacy writers.
  accountNameCanonical              String?                             @unique
  contactEmail                      String?                             @unique
  contactEmailCanonical             String?                             @unique
  passwordHash                      String
  legacyName                        String?                             @map("name")
  role                              Role                                @default(STUDENT)
  status                            AccountStatus                       @default(ACTIVE)
  suspendedAt                       DateTime?
  suspendedReason                   String?
  // 角色变更令牌版本号：管理员修改用户角色时 +1，
  // jwt 回调据此在下次请求时刷新缓存的角色（实时生效机制）。
  tokenVersion                      Int                                 @default(0)
  credentialRevision                Int                                 @default(0)
  revision                          Int                                 @default(0)
  // 首次登入強制改密碼：seed 的學生帳號預設 true，重設密碼後設 false。
  mustChangePassword                Boolean                             @default(true)
  createdAt                         DateTime                            @default(now())
  reviews                           Review[]
  reviewEvents                      ReviewEvent[]
  studySessions                     StudySession[]
  operationReceipts                 OperationReceipt[]
  evidenceObligations               EvidenceObligation[]
  objectiveEvidenceTargets          ObjectiveEvidenceTarget[]
  studyEncounters                   StudyEncounter[]
  securityEventsAsActor             SecurityEvent[]                     @relation("SecurityEventActor")
  securityEventsAsSubject           SecurityEvent[]                     @relation("SecurityEventSubject")
  catalogChangeRequestsProposed     CatalogChangeRequest[]              @relation("CatalogChangeRequestProposer")
  catalogChangeRequestsReviewed     CatalogChangeRequest[]              @relation("CatalogChangeRequestReviewer")
  catalogAuditEvents                CatalogAuditEvent[]                 @relation("CatalogAuditActor")
  catalogSubmissionBatchesProposed  CatalogSubmissionBatch[]            @relation("CatalogSubmissionProposer")
  catalogSubmissionBatchesOwned     CatalogSubmissionBatch[]            @relation("CatalogSubmissionResolutionOwner")
  catalogSubmissionBatchesReviewed  CatalogSubmissionBatch[]            @relation("CatalogSubmissionReviewer")
  catalogSubmissionBatchesFinalized CatalogSubmissionBatch[]            @relation("CatalogSubmissionFinalizer")
  catalogProposalGroupsAuthored     CatalogSubmissionProposalGroup[]    @relation("CatalogProposalLastContentAuthor")
  catalogProposalGroupsDecided      CatalogSubmissionProposalGroup[]    @relation("CatalogProposalDecider")
  catalogProposalAuthors            CatalogSubmissionProposalAuthor[]   @relation("CatalogProposalAuthorActor")
  catalogSubmissionReceipts         CatalogSubmissionOperationReceipt[] @relation("CatalogSubmissionReceiptActor")
  catalogFeedbackReported           CatalogFeedback[]                   @relation("CatalogFeedbackReporter")
  catalogFeedbackResolved           CatalogFeedback[]                   @relation("CatalogFeedbackResolver")
  studyDays                         StudyDay[]
  achievements                      UserAchievement[]
  studentProfile                    StudentProfile?
  teacherProfile                    TeacherProfile?
  teacherClassAccessGrants          TeacherClassAccess[]                @relation("TeacherClassAccessGranter")
  rosterImportBatches               RosterImportBatch[]
  adminMutationBatches              AdminMutationBatch[]                @relation("AdminMutationActor")
  adminOperationReceipts            AdminOperationReceipt[]
  rosterImportUserLinks             RosterImportBatchUserLink[]
  adminMutationUserLinks            AdminMutationBatchUserLink[]
  recentAuthGrants                  RecentAuthGrant[]
  rolloverTransitionsAsActor        StudentYearTransition[]             @relation("TransitionActor")

  @@index([role, status])
}

// ── Legacy-compatible word read model ──
// A fresh catalog can contain the same spelling more than once.  Word remains
// as a read projection for the V1 path and for the expand window; its senseId
// is the canonical link for rows produced by the CSV catalog seed.
model Word {
  id                       String                      @id @default(cuid())
  term                     String
  senseId                  String?                     @unique
  senseKey                 String?
  contentRevisionId        String?
  catalogRevisionId        String?
  phonetic                 String?
  pos                      String?
  definition               String
  level                    Level // A1 / A2 / B1 / B2
  category                 String? // 主题（Family / Colors ...）
  examples                 Json? // 例句数组 [{"en":"...","zh":"..."}]
  synonyms                 String[] // 近义词
  antonyms                 String[] // 反义词
  acceptedAnswers          String[]                    @default([])
  acceptedForms            String[]                    @default([])
  distractorZh             String[]                    @default([])
  distractorEn             String[]                    @default([])
  enableEnToZh             Boolean                     @default(false)
  enableZhToEn             Boolean                     @default(false)
  imageUrl                 String? // 助记图
  sense                    WordSense?                  @relation("WordSenseProjection", fields: [senseId], references: [id], onDelete: SetNull)
  catalogRevision          CatalogRevision?            @relation("CatalogWordProjectionRevision", fields: [catalogRevisionId], references: [id], onDelete: SetNull)
  legacySenseMappings      LegacyWordSenseMap[]
  reviews                  Review[]
  reviewEvents             ReviewEvent[]
  studySessionItems        StudySessionItem[]
  streamItems              StudyStreamItem[]
  evidenceObligations      EvidenceObligation[]
  objectiveEvidenceTargets ObjectiveEvidenceTarget[]
  questionSnapshots        ObjectiveQuestionSnapshot[]
  studyEncounters          StudyEncounter[]

  @@index([level])
  @@index([category])
  @@index([term])
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CatalogChangeKind {
  UPDATE
  CREATE
  RETIRE
  REACTIVATE
}

enum CatalogChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CatalogFeedbackKind {
  DEFINITION
  LEVEL
  PART_OF_SPEECH
  PHONETIC
  EXAMPLE
  DISTRACTOR
  INAPPROPRIATE_WORD
  MISSING_WORD
  OTHER
}

enum CatalogFeedbackStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CatalogSubmissionStatus {
  PREVIEW
  NEEDS_RESOLUTION
  SUBMITTED
  REVIEWING
  REVIEWED
  FINALIZING
  COMMITTED
  REJECTED
  STALE
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum CatalogSubmissionRowRole {
  CANONICAL_SOURCE
  MERGED_SOURCE
  EXCLUDED
}

enum CatalogProposalResolution {
  MERGE
  KEEP_SEPARATE
  LINK_EXISTING
  REPLACE_EXISTING
  REJECT
  ESCALATE
}

enum CatalogProposalDecision {
  PENDING
  APPROVE
  REJECT
}

enum CatalogReviewRisk {
  MATERIAL
  LOW_RISK_METADATA
}

enum CatalogProposalContributionKind {
  UPLOAD
  RESOLUTION_EDIT
  REVIEW_EDIT
  CORRECTIVE_PREVIEW
}

enum CatalogSubmissionOperationKind {
  SUBMIT
  FINALIZE
  RETRY_CLOSE
}

enum CatalogRetryClosureReason {
  NO_LONGER_APPLICABLE
}

enum CatalogHistorySourceKind {
  STANDALONE_REQUEST
  BATCH
  INITIAL_BASELINE
}

// Stable headword identity.  A single entry may contain multiple independent
// senses, for example run=跑步 and run=經營.
model CatalogEntry {
  id              String      @id @default(cuid())
  catalogKey      String      @unique
  lemma           String
  normalizedLemma String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  senses          WordSense[]

  @@index([normalizedLemma])
}

// Stable sense / learning-item identity.  Content is immutable in revisions;
// approvedRevisionId is the only content pointer that runtime code may use.
model WordSense {
  id                       String                           @id @default(cuid())
  catalogEntryId           String
  senseKey                 String                           @unique
  term                     String
  normalizedTerm           String
  pos                      String?
  level                    Level
  category                 String
  status                   CatalogStatus                    @default(DRAFT)
  approvedRevisionId       String?                          @unique
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  catalogEntry             CatalogEntry                     @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  revisions                WordSenseRevision[]              @relation("WordSenseRevisions")
  approvedRevision         WordSenseRevision?               @relation("ApprovedWordSenseRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  wordProjection           Word?                            @relation("WordSenseProjection")
  reviews                  Review[]
  reviewEvents             ReviewEvent[]                    @relation("ReviewEventSense")
  studySessionItems        StudySessionItem[]
  streamItems              StudyStreamItem[]
  evidenceObligations      EvidenceObligation[]
  objectiveTargets         ObjectiveEvidenceTarget[]
  questionSnapshots        ObjectiveQuestionSnapshot[]
  studyEncounters          StudyEncounter[]
  // Deprecated expand-window relation. Runtime and seed no longer read or
  // write environment-scoped catalog eligibility.
  localEligibilities       CatalogEligibility[]
  legacyWordMappings       LegacyWordSenseMap[]
  changeRequests           CatalogChangeRequest[]
  auditEvents              CatalogAuditEvent[]
  submissionProposalGroups CatalogSubmissionProposalGroup[]
  feedback                 CatalogFeedback[]

  @@index([normalizedTerm])
  @@index([level, status])
  @@index([catalogEntryId, level])
}

model WordSenseRevision {
  id                String                 @id @default(cuid())
  senseId           String
  revision          Int
  term              String
  lemma             String
  pos               String?
  level             Level
  category          String
  definitionZh      String
  acceptedAnswersZh String[]               @default([])
  phoneticIpa       String?
  exampleEn         String?
  exampleZh         String?
  acceptedFormsEn   String[]               @default([])
  synonymsEn        String[]               @default([])
  antonymsEn        String[]               @default([])
  enableEnToZh      Boolean                @default(false)
  distractorZh      String[]               @default([])
  enableZhToEn      Boolean                @default(false)
  distractorEn      String[]               @default([])
  contentDigest     String
  sourceReference   String?
  contributorRef    String?
  changeNote        String?
  retirementReason  String?
  catalogRevisionId String?
  createdAt         DateTime               @default(now())
  sense             WordSense              @relation("WordSenseRevisions", fields: [senseId], references: [id], onDelete: Restrict)
  approvedFor       WordSense?             @relation("ApprovedWordSenseRevision")
  catalogRevision   CatalogRevision?       @relation(fields: [catalogRevisionId], references: [id], onDelete: SetNull)
  eligibilities     CatalogEligibility[]
  resultOfRequests  CatalogChangeRequest[] @relation("CatalogChangeResultRevision")

  @@unique([senseId, revision])
  @@index([contentDigest])
  @@index([catalogRevisionId])
}

model CatalogRevision {
  id                   String                   @id @default(cuid())
  revisionKey          String                   @unique
  sourceDigest         String
  taxonomyDigest       String
  validatorVersion     String
  normalizationVersion String
  activationBasis      String
  status               String                   @default("BUILDING")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  senseRevisions       WordSenseRevision[]
  eligibilities        CatalogEligibility[]
  importBatches        CatalogImportBatch[]
  wordProjections      Word[]                   @relation("CatalogWordProjectionRevision")
  submissionBatches    CatalogSubmissionBatch[]

  @@index([status, createdAt])
}

model CatalogEligibility {
  // Deprecated physical compatibility table. Removal requires a separately
  // approved destructive contract migration.
  id                String            @id @default(cuid())
  senseId           String
  senseRevisionId   String
  catalogRevisionId String
  environment       String
  basis             String
  sourceDigest      String
  validatorVersion  String
  reason            String
  createdAt         DateTime          @default(now())
  sense             WordSense         @relation(fields: [senseId], references: [id], onDelete: Restrict)
  senseRevision     WordSenseRevision @relation(fields: [senseRevisionId], references: [id], onDelete: Restrict)
  catalogRevision   CatalogRevision   @relation(fields: [catalogRevisionId], references: [id], onDelete: Restrict)

  @@unique([senseRevisionId, environment])
  @@index([environment, catalogRevisionId])
  @@index([senseId, environment])
}

model CatalogImportBatch {
  id                   String                   @id @default(cuid())
  sourceDigest         String                   @unique
  taxonomyDigest       String
  validatorVersion     String
  normalizationVersion String
  status               String                   @default("PREVIEW")
  catalogRevisionId    String?
  manifest             Json
  report               Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  catalogRevision      CatalogRevision?         @relation(fields: [catalogRevisionId], references: [id], onDelete: SetNull)
  rows                 CatalogImportRow[]
  historyFeedEntry     CatalogHistoryFeedEntry?

  @@index([status, createdAt])
}

model CatalogImportRow {
  id                 String                 @id @default(cuid())
  batchId            String
  sourceFile         String
  sourceRow          Int
  rowDigest          String
  primaryDisposition String
  eligibilityResult  String?
  catalogKey         String?
  senseKey           String?
  issues             Json?
  sourceData         Json?
  createdAt          DateTime               @default(now())
  batch              CatalogImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  changeRequests     CatalogChangeRequest[]

  @@unique([batchId, sourceFile, sourceRow])
  @@index([primaryDisposition])
  @@index([eligibilityResult])
}

// A teacher/admin proposal. Content is kept as a JSON snapshot so a later
// CSV rebuild cannot rewrite an in-flight review request.
model CatalogChangeRequest {
  id                           String                          @id @default(cuid())
  operationId                  String
  requestFingerprint           String
  kind                         CatalogChangeKind
  status                       CatalogChangeStatus             @default(PENDING)
  catalogKey                   String?
  senseKey                     String?
  senseId                      String?
  sourceImportRowId            String?
  submissionProposalGroupId    String?                         @unique
  resultRevisionId             String?
  supersedesRequestId          String?                         @unique
  proposerId                   String
  reviewerId                   String?
  baseRevision                 Int?
  baseStatus                   CatalogStatus?
  proposedRevision             Int?
  revision                     Int                             @default(0)
  payload                      Json
  beforePayloadSnapshot        Json?
  afterPayloadSnapshot         Json?
  reason                       String?
  reviewNote                   String?
  reviewedAt                   DateTime?
  beforeTermSnapshot           String?
  afterTermSnapshot            String?
  beforeNormalizedTermSnapshot String?
  afterNormalizedTermSnapshot  String?
  beforeDefinitionSnapshot     String?
  afterDefinitionSnapshot      String?
  beforeLevelSnapshot          Level?
  afterLevelSnapshot           Level?
  beforeCategorySnapshot       String?
  afterCategorySnapshot        String?
  actorPseudonym               String?
  actorKeyVersion              String?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  sense                        WordSense?                      @relation(fields: [senseId], references: [id], onDelete: Restrict)
  sourceImportRow              CatalogImportRow?               @relation(fields: [sourceImportRowId], references: [id], onDelete: Restrict)
  submissionProposalGroup      CatalogSubmissionProposalGroup? @relation(fields: [submissionProposalGroupId], references: [id], onDelete: Restrict)
  resultRevision               WordSenseRevision?              @relation("CatalogChangeResultRevision", fields: [resultRevisionId], references: [id], onDelete: SetNull)
  supersedesRequest            CatalogChangeRequest?           @relation("CatalogChangeRequestSupersession", fields: [supersedesRequestId], references: [id], onDelete: Restrict)
  supersededBy                 CatalogChangeRequest?           @relation("CatalogChangeRequestSupersession")
  proposer                     User                            @relation("CatalogChangeRequestProposer", fields: [proposerId], references: [id], onDelete: Restrict)
  reviewer                     User?                           @relation("CatalogChangeRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  auditEvents                  CatalogAuditEvent[]
  historyFeedEntry             CatalogHistoryFeedEntry?

  @@unique([proposerId, operationId])
  @@index([status, createdAt])
  @@index([senseId, status])
  @@index([senseKey, status])
  @@index([sourceImportRowId, status])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([kind, createdAt, id])
  @@index([beforeNormalizedTermSnapshot, createdAt, id])
  @@index([afterNormalizedTermSnapshot, createdAt, id])
  @@index([proposerId, createdAt, id])
  @@index([reviewerId, createdAt, id])
}

// A low-friction teacher report. Feedback is deliberately non-executable:
// resolving it never changes a WordSense or its approved revision.
model CatalogFeedback {
  id             String                @id @default(cuid())
  operationId    String
  requestFingerprint String
  reporterId     String
  resolverId     String?
  senseId        String?
  senseKey       String?
  termSnapshot   String?
  baseRevision   Int?
  kind           CatalogFeedbackKind
  status         CatalogFeedbackStatus @default(OPEN)
  message        String
  suggestedValue String?
  resolutionNote String?
  revision       Int                   @default(0)
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  reporter       User                  @relation("CatalogFeedbackReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver       User?                 @relation("CatalogFeedbackResolver", fields: [resolverId], references: [id], onDelete: Restrict)
  sense          WordSense?            @relation(fields: [senseId], references: [id], onDelete: Restrict)

  @@unique([reporterId, operationId])
  @@index([status, createdAt, id])
  @@index([reporterId, status, createdAt, id])
  @@index([senseId, status, createdAt, id])
  @@index([resolverId, resolvedAt, id])
}

model CatalogAuditEvent {
  id                String                  @id @default(cuid())
  requestId         String?
  actorUserId       String?
  senseId           String?
  submissionBatchId String?
  action            String
  fromStatus        String?
  toStatus          String?
  revision          Int?
  metadata          Json?
  createdAt         DateTime                @default(now())
  request           CatalogChangeRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor             User?                   @relation("CatalogAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sense             WordSense?              @relation(fields: [senseId], references: [id], onDelete: SetNull)
  submissionBatch   CatalogSubmissionBatch? @relation(fields: [submissionBatchId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([senseId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([submissionBatchId, createdAt])
}

// A teacher-uploaded governance batch. This is deliberately separate from
// CatalogImportBatch, which belongs exclusively to deterministic seed/import.
model CatalogSubmissionBatch {
  id                     String                              @id @default(cuid())
  proposerId             String
  resolutionOwnerId      String?
  reviewerId             String?
  finalizerId            String?
  operationId            String
  fileName               String
  fileHash               String
  requestDigest          String
  schemaVersion          String
  validatorVersion       String
  normalizationVersion   String
  taxonomyDigest         String
  readyCatalogRevisionId String?
  baseMutationRevision   Int
  status                 CatalogSubmissionStatus             @default(PREVIEW)
  revision               Int                                 @default(0)
  rowCount               Int
  summary                Json
  expiresAt              DateTime
  absoluteExpiresAt      DateTime
  submittedAt            DateTime?
  reviewedAt             DateTime?
  committedAt            DateTime?
  lastActivityAt         DateTime                            @default(now())
  contentPurgedAt        DateTime?
  retryClosedAt          DateTime?
  retryCloseReason       CatalogRetryClosureReason?
  supersedesBatchId      String?
  retryOfBatchId         String?                             @unique
  actorPseudonym         String?
  actorKeyVersion        String?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  proposer               User                                @relation("CatalogSubmissionProposer", fields: [proposerId], references: [id], onDelete: Restrict)
  resolutionOwner        User?                               @relation("CatalogSubmissionResolutionOwner", fields: [resolutionOwnerId], references: [id], onDelete: SetNull)
  reviewer               User?                               @relation("CatalogSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  finalizer              User?                               @relation("CatalogSubmissionFinalizer", fields: [finalizerId], references: [id], onDelete: SetNull)
  readyCatalogRevision   CatalogRevision?                    @relation(fields: [readyCatalogRevisionId], references: [id], onDelete: SetNull)
  supersedesBatch        CatalogSubmissionBatch?             @relation("CatalogSubmissionSupersession", fields: [supersedesBatchId], references: [id], onDelete: SetNull)
  supersededBy           CatalogSubmissionBatch[]            @relation("CatalogSubmissionSupersession")
  retryOfBatch           CatalogSubmissionBatch?             @relation("CatalogSubmissionRetry", fields: [retryOfBatchId], references: [id], onDelete: Restrict)
  retriedBy              CatalogSubmissionBatch?             @relation("CatalogSubmissionRetry")
  rows                   CatalogSubmissionRow[]
  proposalGroups         CatalogSubmissionProposalGroup[]
  receipts               CatalogSubmissionOperationReceipt[]
  auditEvents            CatalogAuditEvent[]
  historyFeedEntry       CatalogHistoryFeedEntry?

  @@unique([proposerId, operationId])
  @@index([proposerId, status, createdAt, id])
  @@index([reviewerId, status, createdAt, id])
  @@index([status, expiresAt])
  @@index([fileHash, proposerId])
}

model CatalogSubmissionRow {
  id                      String                          @id @default(cuid())
  batchId                 String
  rowNumber               Int
  rowDigest               String
  requestedAction         CatalogChangeKind
  primaryDisposition      String
  warnings                Json
  errors                  Json
  normalizedTerm          String
  normalizedLemma         String
  normalizedSourcePayload Json?
  proposalGroupId         String?
  rowRole                 CatalogSubmissionRowRole        @default(CANONICAL_SOURCE)
  createdAt               DateTime                        @default(now())
  batch                   CatalogSubmissionBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  proposalGroup           CatalogSubmissionProposalGroup? @relation(fields: [proposalGroupId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, primaryDisposition, rowNumber])
  @@index([proposalGroupId, rowNumber])
}

model CatalogSubmissionProposalGroup {
  id                       String                            @id @default(cuid())
  batchId                  String
  groupNumber              Int
  requestedAction          CatalogChangeKind
  resolution               CatalogProposalResolution?
  resolutionReason         String?
  retryMergeConflictFields Json?
  targetCatalogKey         String?
  targetSenseKey           String?
  targetSenseId            String?
  baseRevision             Int?
  baseStatus               CatalogStatus?
  dependencyDigest         String
  finalProposalPayload     Json
  payloadDigest            String
  lastContentAuthorId      String
  reviewRisk               CatalogReviewRisk
  reviewRiskVersion        String
  reviewRiskReason         Json
  decision                 CatalogProposalDecision           @default(PENDING)
  decidedById              String?
  decidedAt                DateTime?
  reviewedPayloadDigest    String?
  reviewNote               String?
  revision                 Int                               @default(0)
  actorPseudonym           String?
  actorKeyVersion          String?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  batch                    CatalogSubmissionBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  targetSense              WordSense?                        @relation(fields: [targetSenseId], references: [id], onDelete: Restrict)
  lastContentAuthor        User                              @relation("CatalogProposalLastContentAuthor", fields: [lastContentAuthorId], references: [id], onDelete: Restrict)
  decidedBy                User?                             @relation("CatalogProposalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  sourceRows               CatalogSubmissionRow[]
  authors                  CatalogSubmissionProposalAuthor[]
  changeRequest            CatalogChangeRequest?

  @@unique([batchId, groupNumber])
  @@index([batchId, decision, groupNumber])
  @@index([targetSenseId, createdAt])
  @@index([lastContentAuthorId])
}

model CatalogSubmissionProposalAuthor {
  id               String                          @id @default(cuid())
  proposalGroupId  String
  actorUserId      String
  payloadDigest    String
  contributionKind CatalogProposalContributionKind
  actorPseudonym   String?
  actorKeyVersion  String?
  createdAt        DateTime                        @default(now())
  proposalGroup    CatalogSubmissionProposalGroup  @relation(fields: [proposalGroupId], references: [id], onDelete: Restrict)
  actor            User                            @relation("CatalogProposalAuthorActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([proposalGroupId, actorUserId, payloadDigest, contributionKind])
  @@index([actorUserId, createdAt])
}

model CatalogSubmissionOperationReceipt {
  id                 String                         @id @default(cuid())
  batchId            String
  actorUserId        String
  operationKind      CatalogSubmissionOperationKind
  operationId        String
  requestFingerprint String
  outcomeStatus      CatalogSubmissionStatus
  summary            Json
  createdAt          DateTime                       @default(now())
  batch              CatalogSubmissionBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor              User                           @relation("CatalogSubmissionReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, operationKind, operationId])
  @@index([batchId, createdAt])
}

model CatalogMutationState {
  id        Int      @id
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CatalogHistoryFeedEntry {
  id                   String                   @id @default(cuid())
  occurredAt           DateTime
  sourceKind           CatalogHistorySourceKind
  requestId            String?                  @unique
  submissionBatchId    String?                  @unique
  initialImportBatchId String?                  @unique
  createdAt            DateTime                 @default(now())
  request              CatalogChangeRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  submissionBatch      CatalogSubmissionBatch?  @relation(fields: [submissionBatchId], references: [id], onDelete: Restrict)
  initialImportBatch   CatalogImportBatch?      @relation(fields: [initialImportBatchId], references: [id], onDelete: Restrict)

  @@index([occurredAt, sourceKind, id])
  @@index([sourceKind, occurredAt, id])
}

// Explicit mapping for the one-spelling-one-item V1 compatibility projection.
model LegacyWordSenseMap {
  id        String    @id @default(cuid())
  wordId    String    @unique
  senseId   String    @unique
  isPrimary Boolean   @default(true)
  createdAt DateTime  @default(now())
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sense     WordSense @relation(fields: [senseId], references: [id], onDelete: Restrict)
}

// ── 学习记录（每用户每词一份 SM-2 状态） ──
model Review {
  id             String     @id @default(cuid())
  userId         String
  wordId         String
  senseId        String?
  easeFactor     Float      @default(2.5)
  interval       Int        @default(0)
  repetitions    Int        @default(0)
  nextReviewDate DateTime
  lastReviewedAt DateTime?
  totalReviews   Int        @default(0)
  revision       Int        @default(0)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sense          WordSense? @relation(fields: [senseId], references: [id], onDelete: SetNull)

  @@unique([userId, wordId])
  @@unique([userId, senseId])
  @@index([userId, nextReviewDate])
  @@index([userId, senseId, nextReviewDate])
}

// ── 学习评测事件（每次提交一条，兼作幂等日志） ──
// operationId 由客户端为一次答题生成，并按用户唯一。服务端在 Serializable
// transaction 内先查此表，确保响应丢失后的重试不会重复推进 SM-2。
model ReviewEvent {
  id                          String                     @id @default(cuid())
  operationId                 String
  userId                      String
  submittedWordId             String
  wordId                      String?
  senseId                     String?
  submittedSenseId            String?
  senseKey                    String?
  contentRevisionId           String?
  catalogRevisionId           String?
  // 删除词库项目时仍保留审计／统计；以下快照不依赖当前 Word 行。
  wordTerm                    String
  wordLevel                   Level
  eventKind                   ReviewEventKind            @default(REVIEW)
  // Non-REVIEW bridge/backfill rows use neutral quality=0; eventKind carries semantics.
  quality                     Int
  newlyUnlockedKeys           String[]                   @default([])
  // 迁移前只有累计次数、没有逐次时间；这类回填不可进入日／周时间桶。
  isHistorical                Boolean                    @default(false)
  evidenceKind                String?
  flowVersion                 String?
  qualityPolicyVersion        String?
  probePurpose                String?
  itemConstructionVersion     String?
  objectiveEvidenceTargetId   String?
  objectiveQuestionSnapshotId String?
  createdAt                   DateTime                   @default(now())
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                        Word?                      @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                       WordSense?                 @relation("ReviewEventSense", fields: [senseId], references: [id], onDelete: SetNull)
  objectiveEvidenceTarget     ObjectiveEvidenceTarget?   @relation("ObjectiveTargetReviewEvents", fields: [objectiveEvidenceTargetId], references: [id], onDelete: SetNull)
  objectiveQuestionSnapshot   ObjectiveQuestionSnapshot? @relation("QuestionSnapshotReviewEvents", fields: [objectiveQuestionSnapshotId], references: [id], onDelete: SetNull)

  @@unique([userId, operationId])
  @@index([userId, createdAt])
  @@index([wordId])
  @@index([senseId])
}

enum Level {
  A1
  A2
  B1
  B2
}

enum ReviewEventKind {
  REVIEW
  LEGACY_BRIDGE
  HISTORICAL_BACKFILL
}

enum SecurityEventType {
  PASSWORD_CHANGED
  PASSWORD_RESET_BY_ADMIN
  PASSWORD_RESET_BY_TEACHER
  ROLE_CHANGED
  USER_DELETED
  USER_CREATED
  SESSIONS_REVOKED
  LAST_ADMIN_PROTECTION_TRIGGERED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  NICKNAME_CHANGED
  PROFILE_UPDATED
  CLASS_ACCESS_GRANTED
  CLASS_ACCESS_REVOKED
  STUDENT_CLASS_CHANGED
  STUDENTS_PROMOTED
  ROSTER_IMPORTED
  ROSTER_EXPORTED
  SCHOOL_CLASS_DEACTIVATED
  ACADEMIC_YEAR_ACTIVATED
  ROSTER_IMPORT_PREVIEWED
  ROSTER_IMPORT_COMMITTED
  ROSTER_IMPORT_CANCELLED
  ACADEMIC_YEAR_CREATED
  ACADEMIC_YEAR_UPDATED
  SCHOOL_CLASS_CREATED
  SCHOOL_CLASS_UPDATED
  ADMIN_PROFILE_UPDATED
  TEACHER_CLASS_ACCESS_CHANGED
  IMPORT_CREDENTIALS_ROTATED
}

// Server-issued study session. A client can only submit a scored answer for a
// word that belongs to a live session and has an unused nonce.
model StudySession {
  id                    String             @id @default(cuid())
  userId                String
  queueFingerprint      String
  // Deterministic client retry key for an atomic near-expiry rotation.
  rotationKey           String?            @unique
  expiresAt             DateTime
  retiredAt             DateTime?
  flowVersion           String             @default("v1")
  learningPolicyVersion String?
  mode                  String             @default("global")
  catalogReadMode       String             @default("LEGACY_WORD")
  scopeLevel            Level?
  scopeCategory         String?
  revision              Int                @default(0)
  createdAt             DateTime           @default(now())
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 StudySessionItem[]
  streamItems           StudyStreamItem[]

  @@index([userId, expiresAt])
  @@index([userId, queueFingerprint, expiresAt])
  @@index([userId, retiredAt, expiresAt])
  @@index([userId, flowVersion, expiresAt])
  @@index([expiresAt])
}

model StudySessionItem {
  id            String            @id @default(cuid())
  sessionId     String
  wordId        String
  senseId       String?
  nonce         String            @unique
  usedAt        DateTime?
  renewedAt     DateTime?
  operationId   String?
  sourceItemId  String?           @unique
  session       StudySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word          Word              @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sense         WordSense?        @relation(fields: [senseId], references: [id], onDelete: SetNull)
  sourceItem    StudySessionItem? @relation("StudyCredentialLineage", fields: [sourceItemId], references: [id], onDelete: SetNull)
  successorItem StudySessionItem? @relation("StudyCredentialLineage")

  @@unique([sessionId, wordId])
  @@index([sessionId, usedAt])
  @@index([operationId])
  @@index([sessionId, senseId])
}

// V2 stream item identity. This table intentionally does not share the V1
// [sessionId, wordId] unique constraint: one session may present the same word
// as a Learning Card, an obligation probe and a remediation item.
model StudyStreamItem {
  id                          String                     @id @default(cuid())
  sessionId                   String
  streamItemKey               String
  wordId                      String?
  senseId                     String?
  itemKind                    String
  selectionReason             String
  selectionOverrideReason     String?
  policyVersion               String
  status                      String                     @default("LEASED")
  leaseExpiresAt              DateTime
  credentialDigest            String                     @unique
  credentialExpiresAt         DateTime
  // Short-lived digest-only grants retained for concurrent tabs/devices. The
  // current digest remains the fast-path; this expand-only field records the
  // bounded parent/successor lineage without storing bearer credentials.
  credentialLineage           Json?
  revealedAt                  DateTime?
  usedAt                      DateTime?
  feedbackAcknowledgedAt      DateTime?
  operationId                 String?
  clientRevision              Int?
  objectiveEvidenceTargetId   String?
  objectiveQuestionSnapshotId String?
  workObligationId            String?
  sourceItemId                String?                    @unique
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  session                     StudySession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word                        Word?                      @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                       WordSense?                 @relation(fields: [senseId], references: [id], onDelete: SetNull)
  objectiveEvidenceTarget     ObjectiveEvidenceTarget?   @relation(fields: [objectiveEvidenceTargetId], references: [id], onDelete: SetNull)
  objectiveQuestionSnapshot   ObjectiveQuestionSnapshot? @relation(fields: [objectiveQuestionSnapshotId], references: [id], onDelete: SetNull)
  workObligation              EvidenceObligation?        @relation("WorkStreamItems", fields: [workObligationId], references: [id], onDelete: SetNull)
  sourceItem                  StudyStreamItem?           @relation("StudyStreamItemLineage", fields: [sourceItemId], references: [id], onDelete: SetNull)
  successorItem               StudyStreamItem?           @relation("StudyStreamItemLineage")
  encounter                   StudyEncounter?

  @@unique([sessionId, streamItemKey])
  @@index([sessionId, status, leaseExpiresAt])
  @@index([sessionId, usedAt])
  @@index([operationId])
  @@index([objectiveEvidenceTargetId, status])
  @@index([workObligationId, status])
  @@index([sessionId, senseId, status])
}

model EvidenceObligation {
  id                      String                   @id @default(cuid())
  userId                  String
  wordId                  String?
  senseId                 String?
  kind                    String                   @default("EVIDENCE_OBLIGATION")
  status                  String                   @default("PENDING")
  sourceOperationId       String?
  selectionReason         String
  policyVersion           String
  eligibleAt              DateTime
  expiresAt               DateTime
  leaseOwnerSessionId     String?
  leaseExpiresAt          DateTime?
  admittedAt              DateTime                 @default(now())
  answeredAt              DateTime?
  terminalReason          String?
  activeKey               String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                    Word?                    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                   WordSense?               @relation(fields: [senseId], references: [id], onDelete: SetNull)
  objectiveEvidenceTarget ObjectiveEvidenceTarget? @relation("ObligationTarget")
  encounters              StudyEncounter[]
  workStreamItems         StudyStreamItem[]        @relation("WorkStreamItems")

  @@index([userId, status, eligibleAt, expiresAt])
  @@index([userId, wordId, kind, status])
  @@index([userId, senseId, kind, status])
}

model ObjectiveEvidenceTarget {
  id                      String                     @id @default(cuid())
  userId                  String
  wordId                  String?
  senseId                 String?
  purpose                 String
  expectedReviewRevision  Int?
  policyVersion           String
  itemConstructionVersion String
  status                  String                     @default("OPEN")
  activeKey               String?                    @unique
  obligationId            String?                    @unique
  winningOperationId      String?
  winningReviewEventId    String?
  consumedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                    Word?                      @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                   WordSense?                 @relation(fields: [senseId], references: [id], onDelete: SetNull)
  obligation              EvidenceObligation?        @relation("ObligationTarget", fields: [obligationId], references: [id], onDelete: SetNull)
  reviewEvents            ReviewEvent[]              @relation("ObjectiveTargetReviewEvents")
  streamItems             StudyStreamItem[]
  questionSnapshot        ObjectiveQuestionSnapshot? @relation("TargetQuestionSnapshot")

  @@index([userId, status, purpose])
  @@index([userId, wordId, expectedReviewRevision, purpose])
  @@index([userId, senseId, expectedReviewRevision, purpose])
}

model ObjectiveQuestionSnapshot {
  id                      String                   @id @default(cuid())
  targetId                String?                  @unique
  wordId                  String?
  senseId                 String?
  contentRevisionId       String?
  catalogRevisionId       String?
  prompt                  String
  wordTerm                String
  wordDefinition          String
  direction               String
  options                 Json
  correctOptionId         String
  contentVersion          String
  itemConstructionVersion String
  createdAt               DateTime                 @default(now())
  target                  ObjectiveEvidenceTarget? @relation("TargetQuestionSnapshot", fields: [targetId], references: [id], onDelete: SetNull)
  word                    Word?                    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                   WordSense?               @relation(fields: [senseId], references: [id], onDelete: SetNull)
  streamItems             StudyStreamItem[]
  reviewEvents            ReviewEvent[]            @relation("QuestionSnapshotReviewEvents")

  @@index([wordId, createdAt])
  @@index([senseId, createdAt])
}

model StudyEncounter {
  id                      String              @id @default(cuid())
  userId                  String
  wordId                  String?
  senseId                 String?
  streamItemId            String              @unique
  operationId             String
  selfRating              String
  selectionReason         String
  policyVersion           String
  requiresVerification    Boolean
  verificationDisposition String?
  evidenceObligationId    String?
  createdAt               DateTime            @default(now())
  acknowledgedAt          DateTime            @default(now())
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                    Word?               @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sense                   WordSense?          @relation(fields: [senseId], references: [id], onDelete: SetNull)
  streamItem              StudyStreamItem     @relation(fields: [streamItemId], references: [id], onDelete: Cascade)
  evidenceObligation      EvidenceObligation? @relation(fields: [evidenceObligationId], references: [id], onDelete: SetNull)

  @@unique([userId, operationId])
  @@index([userId, createdAt])
  @@index([userId, wordId, createdAt])
  @@index([userId, senseId, createdAt])
}

// Global idempotency receipt shared by V1 and V2 action namespaces.
model OperationReceipt {
  id                 String   @id @default(cuid())
  userId             String
  operationId        String
  flowVersion        String
  actionKind         String
  requestFingerprint String
  outcomeStatus      String
  outcomeReference   String?
  response           Json?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationId])
  @@index([userId, createdAt])
}

model SecurityEvent {
  id                 String            @id @default(cuid())
  actorUserId        String?
  subjectUserId      String?
  subjectAccountHash String
  actorPseudonym     String?
  subjectPseudonym   String?
  ipPseudonym        String?
  hmacKeyVersion     String?
  eventType          SecurityEventType
  ipHash             String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  actor              User?             @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject            User?             @relation("SecurityEventSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventType, createdAt])
}

// Database-owned environment marker. Seed refuses to write until the caller's
// declared environment matches this persisted value.
model DatabaseMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── 学习打卡（每日一条） ──
// 用于「连续学习天数 / 打卡」，并为后续的成就、排行榜等功能预留数据基础。
// date 存本地日期字符串（Asia/Shanghai，YYYY-MM-DD），按「用户 + 天」幂等打卡，
// 避免 DateTime 的 UTC 时区导致跨日判断错乱。
model StudyDay {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD（Asia/Shanghai 本地日期）
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ── 用户成就解锁记录 ──
// 成就「定义」放在代码常量（src/lib/achievements.ts，key 唯一），
// 本表只记录「哪个用户解锁了哪个成就」，避免频繁改表。
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  key        String // 成就 key（对应 src/lib/achievements.ts 的 ACHIEVEMENTS）
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ── School roster and role-specific identity ──

model StudentProfile {
  userId                  String                  @id
  legalName               String
  nickname                String
  nicknameNormalized      String
  moderationPolicyVersion String                  @default("nickname-v1")
  nicknameUpdatedAt       DateTime?
  profileRevision         Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments             StudentEnrollment[]
  yearTransitions         StudentYearTransition[]

  @@index([legalName])
  @@index([nicknameNormalized])
}

model TeacherProfile {
  userId                  String               @id
  legalName               String
  // Account-level capability; effective reset scope still requires CURRENT
  // class view access for the target student.
  canResetStudentPassword Boolean              @default(false)
  canManageWordCatalog    Boolean              @default(false)
  profileRevision         Int                  @default(0)
  accessRevision          Int                  @default(0)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAccess             TeacherClassAccess[]

  @@index([legalName])
}

model AcademicYear {
  id                   String                  @id @default(cuid())
  label                String                  @unique
  startsOn             DateTime                @db.Date
  endsOn               DateTime                @db.Date
  // Legacy physical column retained during the expand window. New writers
  // use status and never read this field.
  isCurrent            Boolean                 @default(false) @map("isCurrent")
  status               AcademicYearStatus      @default(PLANNED)
  revision             Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  classes              SchoolClass[]
  enrollments          StudentEnrollment[]
  transitionsAsSource  StudentYearTransition[] @relation("TransitionSourceYear")
  transitionsAsTarget  StudentYearTransition[] @relation("TransitionTargetYear")
  rosterImportBatches  RosterImportBatch[]
  adminMutationSources AdminMutationBatch[]    @relation("AdminMutationSourceYear")
  adminMutationTargets AdminMutationBatch[]    @relation("AdminMutationTargetYear")

  @@index([status])
  @@index([isCurrent])
}

model SchoolClass {
  id             String               @id @default(cuid())
  academicYearId String
  grade          StudentGrade
  classCode      ClassCode
  active         Boolean              @default(true)
  revision       Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrollments    StudentEnrollment[]  @relation("EnrollmentClass")
  teacherAccess  TeacherClassAccess[]

  @@unique([academicYearId, grade, classCode])
  @@unique([id, academicYearId, grade])
  @@index([academicYearId, grade, active])
}

model StudentEnrollment {
  id               String                 @id @default(cuid())
  studentId        String
  academicYearId   String
  grade            StudentGrade
  classId          String?
  // 校內學號：按學年／班別編排；未分班學生可暫時留空。
  studentNumber    Int?
  // Legacy physical column retained for old binaries; new writers use status.
  isCurrent        Boolean                @default(true) @map("isCurrent")
  status           EnrollmentStatus       @default(PLANNED)
  origin           EnrollmentOrigin       @default(MANUAL)
  startedAt        DateTime?
  endedAt          DateTime?
  revision         Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  student          StudentProfile         @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  academicYear     AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass      SchoolClass?           @relation("EnrollmentClass", fields: [classId, academicYearId, grade], references: [id, academicYearId, grade], onDelete: Restrict)
  sourceTransition StudentYearTransition? @relation("TransitionSourceEnrollment")
  targetTransition StudentYearTransition? @relation("TransitionTargetEnrollment")

  @@unique([studentId, academicYearId])
  @@index([academicYearId, grade, status])
  @@index([classId, status])
  @@index([studentId, status])
  @@index([academicYearId, studentNumber], map: "StudentEnrollment_academicYear_studentNumber_idx")
}

model TeacherClassAccess {
  teacherId               String         @map("teacherId")
  classId                 String
  canViewProgress         Boolean        @default(true)
  canResetStudentPassword Boolean        @default(false)
  grantedById             String?
  grantedByPseudonym      String?
  hmacKeyVersion          String?
  revision                Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  teacher                 TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  schoolClass             SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grantedBy               User?          @relation("TeacherClassAccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([teacherId, classId])
  @@index([classId, canViewProgress])
}

model RosterImportBatch {
  id               String                      @id @default(cuid())
  actorUserId      String?
  entityType       RosterEntityType
  format           RosterFileFormat
  fileHash         String
  operationId      String
  academicYearId   String?
  mode             String?
  fingerprint      String?
  canonicalDigest  String?
  rosterRevision   Int?
  calendarRevision Int?
  actorPseudonym   String?
  hmacKeyVersion   String?
  status           RosterImportStatus          @default(PREVIEWED)
  rowCount         Int
  createdCount     Int                         @default(0)
  updatedCount     Int                         @default(0)
  skippedCount     Int                         @default(0)
  errorCount       Int                         @default(0)
  stagedRows       Json?
  summary          Json?
  errorReport      Json?
  expiresAt        DateTime
  committedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  actor            User?                       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear?               @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  userLinks        RosterImportBatchUserLink[]

  @@unique([actorUserId, operationId])
  @@index([actorUserId, createdAt])
  @@index([status, expiresAt])
}

