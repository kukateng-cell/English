# =============================================================
# 環境變數範本 — 複製為 .env.local（本地開發）或填入 Vercel 平台
#
#   本地：  cp .env.example .env.local   然後按需填寫
#   線上：  Vercel → Settings → Environment Variables
#
# 資料庫連線字串說明（Supabase / Neon，兩個連接埠用途不同，必須同時設定）：
#   - DATABASE_URL = Transaction pooler（6543，帶 ?pgbouncer=true），runtime 使用
#   - MIGRATE_URL  = Direct connection（優先）或 Session pooler（5432），migration / seed 使用
#   本地 Docker（docker compose up -d）兩者可以相同：
#     postgresql://english:english_dev_password@localhost:5432/english
# =============================================================

# ── 資料庫 ──
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# migration / seed 優先使用 Direct connection；只有 IPv4 的環境可用 Session pooler（5432）。
MIGRATE_URL="postgresql://postgres.REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Seed safety marker. The first seed of a database also requires the matching
# CONFIRM_DATABASE_ENVIRONMENT value; the classification is then persisted.
DATABASE_ENVIRONMENT="development"
CONFIRM_DATABASE_ENVIRONMENT="development"
# Destructive preview-content cleanup needs this additional confirmation in production.
# CONFIRM_CATALOG_PREVIEW_CLEANUP="production"

# ── 認證（NextAuth）──
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="請用隨機字串替換"
# 獨立且長期穩定的審計 HMAC 密鑰；不可與定期輪換的 JWT 密鑰共用。
SECURITY_AUDIT_HASH_SECRET=""
SECURITY_AUDIT_HMAC_SECRET=""
SECURITY_AUDIT_HMAC_KEY_ID="v1"
# Teacher reset precondition AEAD keyring. Each key is a base64url-encoded
# random 32-byte secret; IDs are stable across rotation. Keep the previous
# pair for at least five minutes after rotating current.
TEACHER_RESET_PRECONDITION_KEY_CURRENT=""
TEACHER_RESET_PRECONDITION_KEY_CURRENT_ID="teacher-reset-v1"
TEACHER_RESET_PRECONDITION_KEY_PREVIOUS=""
TEACHER_RESET_PRECONDITION_KEY_PREVIOUS_ID=""
# Audience-neutral v2 reset precondition keyring used by admin and teacher reset
# routes. Keep the previous pair during a rotation window.
PASSWORD_RESET_PRECONDITION_KEY_CURRENT=""
PASSWORD_RESET_PRECONDITION_KEY_CURRENT_ID="password-reset-v2"
PASSWORD_RESET_PRECONDITION_KEY_PREVIOUS=""
PASSWORD_RESET_PRECONDITION_KEY_PREVIOUS_ID=""
# 本地為 http://localhost:3000；線上填入真實網域 https://你的應用.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── 共享限流（Upstash Redis）──
# Production／Vercel production 必須設定，缺少或 backend 故障會 fail closed；只有明確
# non-production local／browser-test runtime 可以使用單實例 memory fallback。
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel 每日清理 expired StudySession；production 使用至少 16 個字元的隨機值。
CRON_SECRET=""

# 預設嚴格要求 operationId。必要時只可填未來不超過 30 分鐘的 ISO 截止時間；
# session/nonce authorization 在相容窗口內仍然強制執行。
STUDY_OPERATION_ID_COMPAT_UNTIL=""

# Retrieval-first Learning Stream v2 assignment. The default is the safe
# internal/test allowlist. Set `all` only in local development to exercise the
# complete V2 product with every authenticated account; production rejects it.
STUDY_V2_ASSIGNMENT_MODE="internal"
STUDY_V2_INTERNAL_USER_IDS=""

# 詞庫治理新工作區。Local development 預設開啟；production 必須逐項明確設為 1。
# 批量提交只可在修改歷史同時啟用，確保每個 batch 都有可追溯紀錄。
CATALOG_HISTORY_ENABLED="0"
CATALOG_BULK_SUBMISSION_ENABLED="0"

# ── Seed（npm run seed）──
# 管理員／教師帳戶初始密碼（必填，seed 時會建立 admin／teacher 帳戶；嚴禁硬編碼）
INITIAL_ADMIN_PASSWORD=""
# Non-production seed also prepares `teacher` (global reset off) and
# `teacher-reset` (global reset on, two current classes) as permission fixtures.
# 設為 1 才建立學生帳戶（預設不建立）。每個新學生會取得不同的一次性臨時密碼；
# 仍處於首次改密狀態的舊帳戶亦會輪換，以清除歷史共用密碼。
SEED_STUDENTS=0
# 本地專用測試學生：密碼獨立於批量學生，mustChangePassword=false，可直接登入。
# production 必須保持 0。
SEED_TEST_STUDENT=0
TEST_STUDENT_USERNAME="__test_student__local"
TEST_STUDENT_WEBKIT_USERNAME="__test_student__local_webkit"
TEST_STUDENT_PASSWORD=""

# ── 本機分析資料（只供 development / test）──
# `seed:demo-analytics` 會重建完整分析資料，但沿用標準
# admin / teacher / student-test 測試帳號及以上 env-owned 密碼，不會另建
# 額外示範登入帳號。不要把真實或 production 密碼寫入此範例檔、版本庫或終端輸出。
