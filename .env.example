# =============================================================
# 环境变量模板 — 复制为 .env.local（本地开发）或填入 Vercel 平台
#
#   本地：  cp .env.example .env.local   然后按需填写
#   线上：  Vercel → Settings → Environment Variables
#
# 数据库连接串说明（Supabase / Neon，两个端口用途不同，务必都配）：
#   - DATABASE_URL = Transaction pooler（6543），运行时用（serverless 短连接复用）
#   - MIGRATE_URL  = Session pooler（5432，带 ?pgbouncer=true），migrate / seed 用
#     （Transaction pooler 不支持 DDL / prepared statements）
#   本地 Docker（docker compose up -d）两者可相同：
#     postgresql://english:english_dev_password@localhost:5432/english
# =============================================================

# ── 数据库 ──
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# migrate / seed 用 Session pooler（5432，必须带 ?pgbouncer=true）
MIGRATE_URL="postgresql://postgres.REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?pgbouncer=true"

# ── 认证（NextAuth）──
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="请用随机串替换"
# 本地为 http://localhost:3000；线上填真实域名 https://你的应用.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── 登录限流（Upstash Redis，生产必填；未配置自动降级为单实例内存限流）──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 两阶段发布：首轮保持 0，让部署前已打开的旧学习页安全排空；确认兼容期结束后设 1。
REQUIRE_STUDY_OPERATION_ID=0

# ── Seed（npm run seed）──
# 管理员 / 教师账号初始密码（必填，seed 时会创建 admin / teacher 账号；严禁硬编码）
INITIAL_ADMIN_PASSWORD=""
# 学生预设密码（student01..40 共用；未设置时 seed 自动生成强随机密码并打印）
SEED_STUDENT_DEFAULT_PASSWORD=""
# 设为 1 才创建学生账号（默认不建）
SEED_STUDENTS=0
# 本地专用测试学生：密码独立于批量学生，mustChangePassword=false，可直接登入。
# 生产必须保持 0。
SEED_TEST_STUDENT=0
TEST_STUDENT_USERNAME="__test_student__local"
TEST_STUDENT_PASSWORD=""
